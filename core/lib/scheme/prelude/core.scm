;;; core.scm -- library procedures written in Scheme.
;;;
;;; Anything that takes a procedure argument lives here rather than in JS, so
;;; call/cc, tail calls and deep recursion work through it. This file is
;;; compiled in "system mode" (see interpreter.js): references to other global
;;; names here are bound to the system table, so a user program that redefines
;;; car / cons / map / length (textbook exercises do) can't break these procedures.

;; ---------------------------------------------------------------- lists

(define (%any-null? ls)
  (cond ((null? ls) #f)
        ((null? (car ls)) #t)
        (else (%any-null? (cdr ls)))))
(define (%cars ls) (if (null? ls) '() (cons (car (car ls)) (%cars (cdr ls)))))
(define (%cdrs ls) (if (null? ls) '() (cons (cdr (car ls)) (%cdrs (cdr ls)))))

(define (map f l . rest)
  (if (null? rest)
      (let loop ((l l))
        (cond ((pair? l) (cons (f (car l)) (loop (cdr l))))
              ((null? l) '())
              (else (%wrong-type l 2 'map))))
      (let loop ((ls (cons l rest)))
        (if (%any-null? ls)
            '()
            (cons (apply f (%cars ls)) (loop (%cdrs ls)))))))

(define (for-each f l . rest)
  (if (null? rest)
      (let loop ((l l))
        (cond ((pair? l) (f (car l)) (loop (cdr l)))
              ((null? l) (if #f #f))
              (else (%wrong-type l 2 'for-each))))
      (let loop ((ls (cons l rest)))
        (if (%any-null? ls)
            (if #f #f)
            (begin (apply f (%cars ls)) (loop (%cdrs ls)))))))

(define (append-map f . ls) (apply append (apply map f ls)))
(define (filter-map f l)
  (let loop ((l l) (acc '()))
    (if (null? l)
        (reverse acc)
        (let ((v (f (car l))))
          (loop (cdr l) (if v (cons v acc) acc))))))

(define (filter pred l)
  (let loop ((l l) (acc '()))
    (cond ((pair? l) (loop (cdr l) (if (pred (car l)) (cons (car l) acc) acc)))
          ((null? l) (reverse acc))
          (else (%wrong-type l 2 'filter)))))
(define (remove pred l) (filter (lambda (x) (not (pred x))) l))
(define (partition pred l)
  (let loop ((l l) (yes '()) (no '()))
    (cond ((null? l) (values (reverse yes) (reverse no)))
          ((pred (car l)) (loop (cdr l) (cons (car l) yes) no))
          (else (loop (cdr l) yes (cons (car l) no))))))

(define (reduce f initial l)
  (if (null? l)
      initial
      (let loop ((acc (car l)) (l (cdr l)))
        (if (null? l) acc (loop (f (car l) acc) (cdr l))))))
(define (reduce-left f initial l)
  (if (null? l)
      initial
      (let loop ((acc (car l)) (l (cdr l)))
        (if (null? l) acc (loop (f acc (car l)) (cdr l))))))
(define (fold-left f init l)
  (let loop ((acc init) (l l))
    (if (null? l) acc (loop (f acc (car l)) (cdr l)))))
(define (fold-right f init l)
  (if (null? l) init (f (car l) (fold-right f init (cdr l)))))
(define (fold f init l)
  (let loop ((acc init) (l l))
    (if (null? l) acc (loop (f (car l) acc) (cdr l)))))

(define (find pred l)
  (let loop ((l l))
    (cond ((null? l) #f)
          ((pred (car l)) (car l))
          (else (loop (cdr l))))))
(define (find-tail pred l)
  (let loop ((l l))
    (cond ((null? l) #f)
          ((pred (car l)) l)
          (else (loop (cdr l))))))
(define (list-index pred l)
  (let loop ((l l) (i 0))
    (cond ((null? l) #f)
          ((pred (car l)) i)
          (else (loop (cdr l) (+ i 1))))))
(define (any pred l)
  (let loop ((l l))
    (cond ((null? l) #f)
          ((null? (cdr l)) (pred (car l)))
          (else (or (pred (car l)) (loop (cdr l)))))))
(define (every pred l)
  (let loop ((l l))
    (cond ((null? l) #t)
          ((null? (cdr l)) (pred (car l)))
          (else (and (pred (car l)) (loop (cdr l)))))))
(define (count pred l)
  (let loop ((l l) (n 0))
    (cond ((null? l) n)
          ((pred (car l)) (loop (cdr l) (+ n 1)))
          (else (loop (cdr l) n)))))
(define (list-tabulate n f)
  (let loop ((i (- n 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (f i) acc)))))
(define make-initialized-list list-tabulate)
(define (append-reverse rev tail)
  (if (null? rev) tail (append-reverse (cdr rev) (cons (car rev) tail))))
(define (list-set! l k v) (set-car! (list-tail l k) v))

(define (member x l . opt)
  (if (null? opt)
      (%member x l)
      (let loop ((l l))
        (cond ((not (pair? l)) #f)
              (((car opt) x (car l)) l)
              (else (loop (cdr l)))))))
(define (assoc x l . opt)
  (if (null? opt)
      (%assoc x l)
      (let loop ((l l))
        (cond ((not (pair? l)) #f)
              (((car opt) x (car (car l))) (car l))
              (else (loop (cdr l)))))))

(define (delete-duplicates l . opt)
  (let ((same? (if (pair? opt) (car opt) equal?)))
    (let loop ((l l) (acc '()))
      (cond ((null? l) (reverse acc))
            ((let mem ((a acc))
               (cond ((null? a) #f)
                     ((same? (car a) (car l)) #t)
                     (else (mem (cdr a)))))
             (loop (cdr l) acc))
            (else (loop (cdr l) (cons (car l) acc)))))))

;; Stable merge sort. Accepts (sort sequence less?) -- list or vector -- and
;; the (sort less? list) argument order some Schemes use.
(define (%sort-list l less?)
  (define (merge a b)
    (cond ((null? a) b)
          ((null? b) a)
          ((less? (car b) (car a)) (cons (car b) (merge a (cdr b))))
          (else (cons (car a) (merge (cdr a) b)))))
  (define (msort l n)
    (if (<= n 1)
        (if (= n 0) '() (list (car l)))
        (let ((h (quotient n 2)))
          (merge (msort l h) (msort (list-tail l h) (- n h))))))
  (msort l (length l)))
(define (sort seq less?)
  (cond ((procedure? seq) (sort less? seq))
        ((vector? seq) (list->vector (%sort-list (vector->list seq) less?)))
        (else (%sort-list seq less?))))
(define sort! sort)
(define list-sort sort)

;; ---------------------------------------------------------------- vectors / strings

(define (vector-map f v . rest)
  (if (null? rest)
      (let* ((n (vector-length v)) (r (make-vector n)))
        (let loop ((i 0))
          (if (< i n)
              (begin (vector-set! r i (f (vector-ref v i))) (loop (+ i 1)))))
        r)
      (list->vector (apply map f (vector->list v) (map vector->list rest)))))
(define (vector-for-each f v . rest)
  (if (null? rest)
      (let ((n (vector-length v)))
        (let loop ((i 0))
          (if (< i n)
              (begin (f (vector-ref v i)) (loop (+ i 1))))))
      (apply for-each f (vector->list v) (map vector->list rest))))
(define (make-initialized-vector n f)
  (let ((v (make-vector n)))
    (let loop ((i 0))
      (if (< i n) (begin (vector-set! v i (f i)) (loop (+ i 1)))))
    v))
(define vector-tabulate (lambda (f n) (make-initialized-vector n f)))
(define (string-for-each f s . rest)
  (apply for-each f (string->list s) (map string->list rest)))
(define (string-map f s . rest)
  (list->string (apply map f (string->list s) (map string->list rest))))
;; Own loop rather than `count`: a library (the word/sentence one) may redefine
;; `count` in the shared system table.
(define (string-count s pred)
  (let ((pred (if (char? pred) (lambda (c) (char=? c pred)) pred)))
    (let loop ((l (string->list s)) (n 0))
      (cond ((null? l) n)
            ((pred (car l)) (loop (cdr l) (+ n 1)))
            (else (loop (cdr l) n))))))

;; ---------------------------------------------------------------- streams

(define the-empty-stream '())
(define stream-nil '())
(define (stream-null? x) (null? x))
(define empty-stream? stream-null?)
(define (stream-car s) (if (stream-pair? s) (car s) (%wrong-type s 1 'stream-car)))
(define (stream-cdr s) (if (stream-pair? s) (force (cdr s)) (%wrong-type s 1 'stream-cdr)))
(define stream-first stream-car)
(define stream-rest stream-cdr)
(define (stream-head s n)
  (if (= n 0) '() (cons (stream-car s) (stream-head (stream-cdr s) (- n 1)))))
(define (stream-tail s n)
  (if (= n 0) s (stream-tail (stream-cdr s) (- n 1))))
(define (stream-ref s n)
  (if (= n 0) (stream-car s) (stream-ref (stream-cdr s) (- n 1))))
(define (stream->list s . opt)
  (let loop ((s s) (n (if (pair? opt) (car opt) -1)) (acc '()))
    (if (or (null? s) (= n 0))
        (reverse acc)
        (loop (stream-cdr s) (- n 1) (cons (stream-car s) acc)))))
(define (list->stream l)
  (if (null? l) '() (cons-stream (car l) (list->stream (cdr l)))))
(define (stream . items) (list->stream items))
(define (stream-map f s . rest)
  (if (null? rest)
      (let loop ((s s))
        (if (null? s) '() (cons-stream (f (stream-car s)) (loop (stream-cdr s)))))
      (let loop ((ss (cons s rest)))
        (if (%any-null? ss)
            '()
            (cons-stream (apply f (map stream-car ss)) (loop (map stream-cdr ss)))))))
(define (stream-for-each f s)
  (let loop ((s s))
    (if (null? s) (if #f #f) (begin (f (stream-car s)) (loop (stream-cdr s))))))
(define (stream-filter pred s)
  (cond ((null? s) '())
        ((pred (stream-car s)) (cons-stream (stream-car s) (stream-filter pred (stream-cdr s))))
        (else (stream-filter pred (stream-cdr s)))))
(define (stream-append . ss)
  (let outer ((ss ss))
    (cond ((null? ss) '())
          ((null? (car ss)) (outer (cdr ss)))
          (else (cons-stream (stream-car (car ss))
                             (outer (cons (stream-cdr (car ss)) (cdr ss))))))))

;; ---------------------------------------------------------------- hash tables

(define (hash-table-ref table key . rest)
  (let ((v (%hash-table-ref table key)))
    (if (%hash-table-not-found? v)
        (if (and (pair? rest) (car rest))
            ((car rest))
            (error "key not found:" key))
        (if (and (pair? rest) (pair? (cdr rest)))
            ((cadr rest) v)
            v))))
(define (hash-table-update! table key proc . rest)
  (hash-table-set! table key (proc (apply hash-table-ref table key rest))))
(define (hash-table-update!/default table key proc default)
  (hash-table-set! table key (proc (hash-table-ref/default table key default))))
(define (hash-table-walk table proc)
  (for-each (lambda (p) (proc (car p) (cdr p))) (hash-table->alist table)))

;; ---------------------------------------------------------------- dynamic state

(define (with-output-to-string . opt)
  (let ((port (open-output-string)) (old #f))
    (if (pair? opt)
        (dynamic-wind
          (lambda () (set! old (%set-current-output! port)))
          (car opt)
          (lambda () (%set-current-output! old))))
    (get-output-string port)))

(define (%parameterize params vals thunk)
  (let ((olds #f))
    (dynamic-wind
      (lambda ()
        (set! olds (map %parameter-value params))
        (for-each %parameter-set! params vals))
      thunk
      (lambda ()
        (set! vals (map %parameter-value params))
        (for-each %parameter-set! params olds)))))
(define-syntax parameterize
  (syntax-rules ()
    ((_ () body ...) (let () body ...))
    ((_ ((p v) ...) body ...)
     (%parameterize (list p ...) (list v ...) (lambda () body ...)))))

;; fluid-let
(define-syntax fluid-let
  (syntax-rules ()
    ((_ ((v e) ...) body ...)
     (let ((new (list e ...)) (old #f))
       (dynamic-wind
         (lambda () (set! old (list v ...)) (%fluid-set! (v ...) new))
         (lambda () body ...)
         (lambda () (set! new (list v ...)) (%fluid-set! (v ...) old)))))))
(define-syntax %fluid-set!
  (syntax-rules ()
    ((_ () lst) #t)
    ((_ (v rest ...) lst)
     (let ((l lst)) (set! v (car l)) (%fluid-set! (rest ...) (cdr l))))))

;; trace / untrace: (trace f) replaces the binding of f with a wrapper that reports
;; each call and its result; (untrace f) puts the original back. The wrapper table
;; stays behind procedures (library state is not seen by user code otherwise).
(define %trace-operations
  (let ((originals (make-strong-eqv-hash-table)))
    (define (original-of proc) (hash-table-ref/default originals proc proc))
    (define (print-args args)
      (if (null? args)
          (display "]")
          (begin
            (newline)
            (display "    Args: ")
            (write (car args))
            (for-each (lambda (a) (newline) (display "          ") (write a)) (cdr args))
            (display "]")))
      (newline))
    (define (wrap name proc)
      (if (not (procedure? proc)) (error "Not a procedure -- TRACE" name))
      (let ((original (original-of proc)))
        (let ((wrapper
               (lambda args
                 (fresh-line)
                 (display "[Entering ")
                 (write original)
                 (print-args args)
                 (let ((result (apply original args)))
                   (fresh-line)
                   (display "[")
                   (write result)
                   (newline)
                   (display "      <== ")
                   (write original)
                   (print-args args)
                   result))))
          (hash-table-set! originals wrapper original)
          wrapper)))
    (cons wrap original-of)))
(define %trace-wrap (car %trace-operations))
(define %trace-original (cdr %trace-operations))
(define-syntax trace
  (syntax-rules ()
    ((_) (if #f #f))
    ((_ name rest ...) (begin (set! name (%trace-wrap 'name name)) (trace rest ...)))))
(define-syntax untrace
  (syntax-rules ()
    ((_) (if #f #f))
    ((_ name rest ...) (begin (set! name (%trace-original name)) (untrace rest ...)))))

