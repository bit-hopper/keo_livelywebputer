# Copy this file to .env.local (already gitignored -- see .gitignore's
# .env/.env.local/.env.*.local rules) and fill in real values there.
# scripts/dev-init.sh sources .env.local automatically if it exists.
# Never put real credentials in this file -- it's the committed template.

# Required. No SQLite fallback exists for objects/handles/friends/
# constellations anymore -- postgres-client.js throws if this is unset.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/lk_dev

# Optional. Unsets the realtime backplane (SessionTracker/RoomSignaling/
# LiveDocSync fall back to single-process in-memory state -- fine for a
# single --workers 1 dev instance, not for --workers >1 or multi-instance).
REDIS_URL=redis://localhost:6379

# Optional. bin/lk-server.js generates a random one in the cluster primary
# if unset -- fine for a single continuous session, but every restart
# invalidates all existing signed-in sessions if left unset. Set this to
# keep sessions valid across restarts.
#SESSION_SECRET=

# Optional. Game search in the Gaming world template (a developer application
# registered with the game database provider; its account needs two-factor
# sign-in). Without them the search answers 503 and the template falls back to
# adding a game by title.
# Can instead go in core/apis/igdb-api.json (gitignored).
#IGDB_CLIENT_ID=
#IGDB_CLIENT_SECRET=

# Optional. Linking a game-store account (Settings > Connected). The credential
# vault seals the access token a store issues (AES-256-GCM, bound to the account) under
# a key that lives ONLY here: never in the repo, never in core/apis/*.json. Generate a
# key with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEYS is a JSON object of version -> base64 key; KEY_CURRENT is the version used for new
# seals. To rotate: add a new version, point KEY_CURRENT at it, keep the old one until
# every row has been re-sealed. Without them, store sign-in that needs a token is
# unavailable (the store that only proves identity still works).
#LINKED_ACCOUNTS_KEYS={"1":"<base64 of 32 random bytes>"}
#LINKED_ACCOUNTS_KEY_CURRENT=1
# The client id of the OAuth application registered with the store that issues tokens
# (loopback redirect http://localhost:9001/nodejs/GameLinkServer/callback/itch for dev;
# HTTPS in production). Not a secret: the flow uses PKCE instead of a client secret.
#ITCH_CLIENT_ID=

# Optional. Defaults used by scripts/dev-init.sh if left unset.
#PORT=9001
#WORKERS=2
