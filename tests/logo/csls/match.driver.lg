to try :code
type :code type "|  =>  |
make "r "NONE
catch "error [make "r runresult :code]
make "e error
if not emptyp :e [print :e stop]
print :r
end
print "=====DRIVER=====
try [show match [a b c] [a b c]]
try [show match [a b c] [a b d]]
try [show match [a b c] [a b]]
try [show match [a ! c] [a b c]]
try [show match [a !x c] [a b c]]
try [show :x]
try [show match [my name is !name:wordp] [my name is brian]]
try [show :name]
try [show match [!x:numberp !y:numberp] [3 4]]
try [show match [!x:numberp !y:numberp] [3 four]]
try [show (list :x :y)]
try [show match [a ?z c] [a b c]]
try [show :z]
try [show match [a ?z c] [a c]]
try [show :z]
try [show match [a #x c] [a 1 2 3 c]]
try [show :x]
try [show match [a #x c] [a c]]
try [show :x]
try [show match [a &x c] [a c]]
try [show match [&x end] [a b end]]
try [show :x]
try [show match [^x end] [a b end end]]
try [show :x]
try [show match [#x:numberp !y] [1 2 3 four]]
try [show (list :x :y)]
try [show match [!w:in [red green]] [green]]
try [show match [!w:anyof [[a b] [c d]]] [c]]
try [show match [@g:[a b] c] [a b c]]
try [show match [a [b !q] c] [a [b 5] c]]
try [show quoted "abc]
try [show quoted [a b]]
try [show match "abc [a]]
