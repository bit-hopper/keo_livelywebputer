to try :code
type :code type "|  =>  |
make "r "NONE
catch "error [make "r runresult :code]
make "e error
if not emptyp :e [print :e stop]
print :r
end
print "=====DRIVER=====
pour [3 5] 4
pour [4 7] 5
pour [5 7] 6
pour [2 4] 3
pour [3 5 8] 7
try [show all.empty [1 2 3]]
try [show replace [a b c] 2 "x]
try [show replace2 [a b c d] 1 "p 3 "q]
