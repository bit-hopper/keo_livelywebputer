to try :code
type :code type "|  =>  |
make "r "NONE
catch "error [make "r runresult :code]
make "e error
if not emptyp :e [print :e stop]
print :r
end
print "=====DRIVER=====
to norm :w
output map [ifelse ? = "j ["i] [?]] :w
end
try [show norm playfair "monarchy [attack at dawn]]
try [show norm playfair "keyword [hello world]]
try [show norm playfair "playfair [meet me at the park]]
try [show norm playfair "monarchy [balloon]]
try [show norm playfair "monarchy [x]]
try [show jtoi "jazz]
try [show remove "ab "abcabc]
try [show rotate 6]
try [show rotate 3]
