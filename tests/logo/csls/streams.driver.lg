to try :code
type :code type "|  =>  |
make "r "NONE
catch "error [make "r runresult :code]
make "e error
if not emptyp :e [print :e stop]
print :r
end
print "=====DRIVER=====
try [(show.stream :integers 5)]
try [(show.stream :primes 8)]
make "sq stream.map [? * ?] :integers
try [(show.stream :sq 6)]
make "ev stream.filter [equalp 0 remainder ? 2] :integers
try [(show.stream :ev 5)]
try [show head tail tail :integers]
try [show head tail :primes]
make "k 3
make "mult stream.map `[? * ,:k] :integers
try [(show.stream :mult 5)]
try [show integers.from 7]
try [show head :integers]
try [show tail [1]]
try [show divisiblep 12 4]
