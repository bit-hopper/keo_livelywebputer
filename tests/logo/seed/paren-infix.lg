to try :code
type :code type "|  =>  |
make "r "NONE
catch "error [make "r runresult :code]
make "e error
if not emptyp :e [print :e stop]
print :r
end
make "x 10
to three
output 3
end
to two :a
output :a
end
try [show (three - 1)]
try [show (three-1)]
try [show (three + 1) * 2]
try [show (three * 2) + 1]
try [show (three) - 1]
try [show (three 5)]
try [show (two 5 - 1)]
try [show (two 5) - 1]
try [show (sum 1 2 - 3)]
try [show (sum 1 2 3)]
try [show (repcount - 1)]
try [repeat 2 [show (repcount - 1)]]
try [repeat 2 [show (# - 1)]]
try [repeat 2 [show (# + 1) * 2]]
try [show map [(? - 1)] [5 6]]
try [show map [(? * 2) + 1] [5 6]]
try [show (? 1)]
try [show (first [1 2] - 1)]
try [show (count [1 2] + 1)]
try [show (thing "x - 1)]
try [show (-1)]
try [show (- 1)]
try [show (three = 3)]
try [show (three < 4)]
try [show (three / 2)]
try [show (list 1 2 = 3)]
try [show (- three)]
