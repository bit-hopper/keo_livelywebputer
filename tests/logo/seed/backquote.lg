to try :code
type :code type "|  =>  |
make "r "NONE
catch "error [make "r runresult :code]
make "e error
if not emptyp :e [print :e stop]
print :r
end
make "x 5
make "w "hello
make "l [p q]
make "e []
try [show `[foo baz ,[bf [a b c]] garply ,@[bf [a b c]]]]
