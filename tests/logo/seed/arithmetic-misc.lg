to try :code
type :code type "|  =>  |
make "r "NONE
catch "error [make "r runresult :code]
make "e error
if not emptyp :e [print :e stop]
print :r
end
try [print sin 90]
try [print cos 0]
try [print arctan 1]
try [print (arctan 1 1)]
try [print (arctan 0 -1)]
try [print radsin 1]
try [print ln 10]
try [print log10 100]
try [print sqrt -1]
try [print random 1]
try [print power -8 1/3]
try [print 5 % 3]
try [print 2 ^ 3]
try [print "a < "b]
try [print 10 < 9]
try [print "10 < "9]
try [print equalp 10 "10]
try [print form 2.5 0 0]
try [print form -2.5 6 1]
try [print int 1e20]
try [print 1e15 + 1]
try [print 123456789 * 1000]
try [print 0.000001]
try [print 0.0000001]
try [print 1234567.891]
try [print 12345678901234567890]
try [print sum 1e15 0.3]
try [print minus 0]
try [print 0 * -1]
try [print 3.10]
try [print -0.5]
try [print .5]
try [print 5.]
try [print (sum 1 2 3 4)]
try [print (difference 10 1 2)]
try [print (product 2 3 4)]
try [print (quotient 8 2 2)]
try [print (quotient 4)]
try [print difference 1]
bye
