print [--- templates]
print apply [[x] :x+3] [5]
print apply [[x] [output :x+3]] [5]
print apply [[x] output :x+3] [5]
print apply [[x] [:x+3]] [5]
show map [? * ?] [2 3 4 5]
show (map [(word ?1 ?2 ?1)] [a b c] [d e f])
show (map "word [a b c] [d e f])
show filter [? > 2] [1 2 3 4]
show reduce "sum [1 2 3]
show reduce [?1 - ?2] [10 3 2]
show cascade 5 [lput # ?] []
show cascade 5 [# * ?] 1
foreach [a b c] [type ?] print []
repeat 3 [type repcount] print []
for [i 1 5 2] [type :i] print []
for [i 5 1 -2] [type :i] print []
show find [? > 2] [1 2 3 4]
show (crossmap [word ?1 ?2] [a b] [1 2])
show iseq 1 5
show iseq 5 1
show remove "a [a b a c]
show reverse [1 2 3]
show pick [a]
show gensym
show count (iseq 1 10)
print [--- stop/output via run]
to s1
repeat 5 [if repcount = 3 [stop] type repcount]
print "after
end
s1
to s2
run [stop]
print "notreached
end
s2
to s3
foreach [1 2 3] [if ? = 2 [stop] type ?]
print "after3
end
s3
to s4
print runresult [print 1]
show runresult [sum 1 2]
end
s4
