#lang simply

;; Solutions for the practice exercises on input and output, files and vectors. Our own code.
;; A browser cell has no files, so the file exercises take ports (string ports in the tests).

;; ---- chapter 20: input and output
(define (my-show thing)
  (display thing)
  (newline))

(define (converse)
  (display "Hello, I'm the computer.  What's your name? ")
  (let ((name (read-line)))
    (display "Hi, ")
    (display (first name))
    (display ".  How are you? ")
    (read-line)
    (show "Glad to hear it.")))

(define (longest-last-name names)
  (if (null? names)
      0
      (max (count (cadar names)) (longest-last-name (cdr names)))))
(define (name-table-rows names width)
  (if (null? names)
      'done
      (begin (display (align (cadar names) width))
             (show (caar names))
             (name-table-rows (cdr names) width))))
(define (name-table names)
  (name-table-rows names (+ 2 (longest-last-name names))))

(define (square-free? position square)
  (equal? (item square position) '_))
(define (ask-for-square position)
  (display "Which square? ")
  (let ((answer (read)))
    (cond ((not (number? answer))
           (show "Please type a number.")
           (ask-for-square position))
          ((or (not (integer? answer)) (< answer 1) (> answer 9))
           (show "Please type a number from 1 to 9.")
           (ask-for-square position))
          ((not (square-free? position answer))
           (show "That square is taken.")
           (ask-for-square position))
          (else answer))))

;; ---- chapter 22: files (here: ports)
(define (copy-ports in-ports out-port)
  (if (null? in-ports)
      'done
      (begin (let loop ()
               (let ((line (read-string (car in-ports))))
                 (if (not (eof-object? line))
                     (begin (show line out-port) (loop)))))
             (copy-ports (cdr in-ports) out-port))))

(define (count-lines port)
  (let loop ((n 0))
    (if (eof-object? (read-string port)) n (loop (+ n 1)))))
(define (count-words port)
  (let loop ((n 0))
    (let ((line (read-line port)))
      (if (eof-object? line) n (loop (+ n (count line)))))))
(define (count-characters port)
  (let loop ((n 0))
    (if (eof-object? (read-char port)) n (loop (+ n 1)))))

(define (drop-repeated-lines in out)
  (let loop ((previous #f))
    (let ((line (read-line in)))
      (if (eof-object? line)
          'done
          (begin (if (not (equal? line previous)) (show-line line out))
                 (loop line))))))

(define (lines-containing port wd out)
  (let loop ()
    (let ((line (read-line port)))
      (if (eof-object? line)
          'done
          (begin (if (member? wd line) (show-line line out))
                 (loop))))))

(define (join in1 in2 pos1 pos2 out)
  (let loop ((a (read in1)) (b (read in2)))
    (cond ((or (eof-object? a) (eof-object? b)) 'done)
          ((equal? (item pos1 a) (item pos2 b))
           (show (append a (cdr b)) out)
           (loop (read in1) (read in2)))
          ((before? (item pos1 a) (item pos2 b)) (loop (read in1) b))
          (else (loop a (read in2))))))

;; ---- chapter 23: vectors
(define (sum-vector v)
  (let loop ((i 0) (total 0))
    (if (= i (vector-length v))
        total
        (loop (+ i 1) (+ total (vector-ref v i))))))

(define (my-vector-fill! v thing)
  (let loop ((i 0))
    (if (< i (vector-length v))
        (begin (vector-set! v i thing) (loop (+ i 1))))))

(define (vector-append2 a b)
  (let ((result (make-vector (+ (vector-length a) (vector-length b)) 0)))
    (let copy-a ((i 0))
      (if (< i (vector-length a))
          (begin (vector-set! result i (vector-ref a i)) (copy-a (+ i 1)))))
    (let copy-b ((i 0))
      (if (< i (vector-length b))
          (begin (vector-set! result (+ i (vector-length a)) (vector-ref b i)) (copy-b (+ i 1)))))
    result))

(define (my-vector->list v)
  (let loop ((i (- (vector-length v) 1)) (result '()))
    (if (< i 0)
        result
        (loop (- i 1) (cons (vector-ref v i) result)))))

(define (my-vector-map f v)
  (let ((result (make-vector (vector-length v) 0)))
    (let loop ((i 0))
      (if (< i (vector-length v))
          (begin (vector-set! result i (f (vector-ref v i))) (loop (+ i 1)))))
    result))
(define (my-vector-map! f v)
  (let loop ((i 0))
    (if (< i (vector-length v))
        (begin (vector-set! v i (f (vector-ref v i))) (loop (+ i 1)))))
  v)

;; a lap counter for a hundred cars
(define *laps* (make-vector 100 0))
(define *winner* #f)
(define (lap car-number)
  (vector-set! *laps* car-number (+ 1 (vector-ref *laps* car-number)))
  (if (and (= (vector-ref *laps* car-number) 200) (not *winner*))
      (begin (set! *winner* car-number)
             (display "Car ") (display car-number) (show " wins!")))
  (vector-ref *laps* car-number))

(define (leader-helper best index)
  (cond ((= index 100) best)
        ((> (vector-ref *laps* index) (vector-ref *laps* best)) (leader-helper index (+ index 1)))
        (else (leader-helper best (+ index 1)))))
(define (leader) (leader-helper 0 1))
;; the version from the exercise: it asks lap for the counts, and lap adds a lap each time
(define (leader-by-calling-lap-helper best index)
  (cond ((= index 100) best)
        ((> (lap index) (lap best)) (leader-by-calling-lap-helper index (+ index 1)))
        (else (leader-by-calling-lap-helper best (+ index 1)))))

(define *menu* '((potstickers 4.50) (wor-won-ton 5.35) (egg-rolls 2.75) (shin-shin-special-prawns 4.00)))
(define *tables* (make-vector 20 0))
(define (order table thing)
  (vector-set! *tables* table (+ (vector-ref *tables* table) (cadr (assoc thing *menu*)))))
(define (bill table)
  (let ((total (vector-ref *tables* table)))
    (vector-set! *tables* table 0)
    total))

(define (vector-swap! v i j)
  (let ((saved (vector-ref v i)))
    (vector-set! v i (vector-ref v j))
    (vector-set! v j saved)))
(define (broken-swap! v i j)             ; the version from the exercise
  (vector-set! v i (vector-ref v j))
  (vector-set! v j (vector-ref v i)))

(define (index-of-smallest v from)
  (let loop ((best from) (i (+ from 1)))
    (cond ((= i (vector-length v)) best)
          ((< (vector-ref v i) (vector-ref v best)) (loop i (+ i 1)))
          (else (loop best (+ i 1))))))
(define (snapshot v) (list->vector (vector->list v)))
(define (selection-sort-stages! v)       ; sorts v in place; returns the vector after each exchange
  (let loop ((i 0) (stages '()))
    (if (= i (- (vector-length v) 1))
        (reverse stages)
        (begin (vector-swap! v i (index-of-smallest v i))
               (loop (+ i 1) (cons (snapshot v) stages))))))

(define (make-matrix rows columns)
  (let ((m (make-vector rows 0)))
    (let loop ((r 0))
      (if (< r rows)
          (begin (vector-set! m r (make-vector columns 0)) (loop (+ r 1)))))
    m))
(define (matrix-ref m row column) (vector-ref (vector-ref m row) column))
(define (matrix-set! m row column thing) (vector-set! (vector-ref m row) column thing))

(define (make-array dimensions)
  (if (null? (cdr dimensions))
      (make-vector (car dimensions) 0)
      (let ((a (make-vector (car dimensions) 0)))
        (let loop ((i 0))
          (if (< i (car dimensions))
              (begin (vector-set! a i (make-array (cdr dimensions))) (loop (+ i 1)))))
        a)))
(define (array-ref a indexes)
  (if (null? (cdr indexes))
      (vector-ref a (car indexes))
      (array-ref (vector-ref a (car indexes)) (cdr indexes))))
(define (array-set! a indexes thing)
  (if (null? (cdr indexes))
      (vector-set! a (car indexes) thing)
      (array-set! (vector-ref a (car indexes)) (cdr indexes) thing)))

;; sentences as vectors
(define (vs-pieces thing)
  (cond ((vector? thing) (vector->list thing))
        (else (list thing))))
(define (vs-sentence . things)
  (list->vector (apply append (map vs-pieces things))))
(define (vs-empty? s) (= 0 (vector-length s)))
(define (vs-first s) (vector-ref s 0))
(define (vs-last s) (vector-ref s (- (vector-length s) 1)))
(define (vs-butfirst s) (list->vector (cdr (vector->list s))))
(define (vs-butlast s) (list->vector (reverse (cdr (reverse (vector->list s))))))
